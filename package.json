{
  "name": "cucumberautocomplete",
  "version": "3.1.2",
  "publisher": "alexkrechik",
  "author": "Alexander Krechik",
  "license": "MIT",
  "displayName": "Cucumber Beautifier",
  "description": "Internal Cucumber language support, formatting, and autocomplete for Cursor and VS Code",
  "homepage": "https://github.com/ohlori/cucumber-beautifier",
  "engines": {
    "vscode": "^1.85.0",
    "node": "^22.13.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ohlori/cucumber-beautifier"
  },
  "bugs": {
    "url": "https://github.com/ohlori/cucumber-beautifier/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gherkin",
    "cucumber",
    "feature",
    "autocomplete"
  ],
  "main": "./gclient/out/extension",
  "icon": "img/icon.png",
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "feature",
          "gherkin",
          "Gherkin",
          "cucumber"
        ],
        "extensions": [
          ".feature",
          ".testcase"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./img/cucumber.png",
          "dark": "./img/cucumber.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "feature",
        "scopeName": "text.gherkin.feature",
        "path": "./syntaxes/feature.tmLanguage.json"
      },
      {
        "injectTo": [
          "text.gherkin.feature"
        ],
        "scopeName": "text.gherkin.feature.json",
        "path": "./syntaxes/json-embed.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      }
    ],
    "snippets": [
      {
        "language": "feature",
        "path": "./snippets.json"
      }
    ],
    "configuration": {
      "title": "Cucumber Auto Complete settings",
      "properties": {
        "cucumberautocomplete.steps": {
          "description": "Path or array of glob-style-pathes to the steps files",
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "required": false,
          "default": []
        },
        "cucumberautocomplete.gherkinLanguage": {
          "description": "Global Gherkin language used for every feature file in the current editor window or workspace.",
          "type": "string",
          "scope": "window",
          "enum": [
            "af", "am", "amh", "an", "ar", "ast", "az", "be", "bg", "bm",
            "bs", "ca", "cs", "cy-GB", "da", "de", "el", "em", "en",
            "en-Scouse", "en-au", "en-lol", "en-old", "en-pirate", "en-tx",
            "eo", "es", "et", "fa", "fi", "fr", "ga", "gj", "gl", "he",
            "hi", "hr", "ht", "hu", "id", "is", "it", "ja", "jv", "ka",
            "kn", "ko", "lt", "lu", "lv", "mk-Cyrl", "mk-Latn", "ml", "mn",
            "mr", "ne", "nl", "no", "pa", "pl", "pt", "ro", "ru", "sk",
            "sl", "sr-Cyrl", "sr-Latn", "sv", "ta", "te", "th", "tlh", "tr",
            "tt", "uk", "ur", "uz", "vi", "zh-CN", "zh-TW"
          ],
          "enumItemLabels": [
            "Afrikaans — Afrikaans",
            "Armenian — հայերեն",
            "Amharic — አማርኛ",
            "Aragonese — Aragonés",
            "Arabic — العربية",
            "Asturian — asturianu",
            "Azerbaijani — Azərbaycanca",
            "Belarusian — Беларуская",
            "Bulgarian — български",
            "Malay — Bahasa Melayu",
            "Bosnian — Bosanski",
            "Catalan — català",
            "Czech — Česky",
            "Welsh — Cymraeg",
            "Danish — dansk",
            "German — Deutsch",
            "Greek — Ελληνικά",
            "Emoji — 😀",
            "English — English",
            "Scouse — Scouse",
            "Australian — Australian",
            "LOLCAT — LOLCAT",
            "Old English — Englisc",
            "Pirate — Pirate",
            "Texas — Texas",
            "Esperanto — Esperanto",
            "Spanish — español",
            "Estonian — eesti keel",
            "Persian — فارسی",
            "Finnish — suomi",
            "French — français",
            "Irish — Gaeilge",
            "Gujarati — ગુજરાતી",
            "Galician — galego",
            "Hebrew — עברית",
            "Hindi — हिंदी",
            "Croatian — hrvatski",
            "Creole — kreyòl",
            "Hungarian — magyar",
            "Indonesian — Bahasa Indonesia",
            "Icelandic — Íslenska",
            "Italian — italiano",
            "Japanese — 日本語",
            "Javanese — Basa Jawa",
            "Georgian — ქართული",
            "Kannada — ಕನ್ನಡ",
            "Korean — 한국어",
            "Lithuanian — lietuvių kalba",
            "Luxemburgish — Lëtzebuergesch",
            "Latvian — latviešu",
            "Macedonian — Македонски",
            "Macedonian (Latin) — Makedonski (Latinica)",
            "Malayalam — മലയാളം",
            "Mongolian — монгол",
            "Marathi — मराठी",
            "Nepali — नेपाली",
            "Dutch — Nederlands",
            "Norwegian — norsk",
            "Panjabi — ਪੰਜਾਬੀ",
            "Polish — polski",
            "Portuguese — português",
            "Romanian — română",
            "Russian — русский",
            "Slovak — Slovensky",
            "Slovenian — Slovenski",
            "Serbian — Српски",
            "Serbian (Latin) — Srpski (Latinica)",
            "Swedish — Svenska",
            "Tamil — தமிழ்",
            "Telugu — తెలుగు",
            "Thai — ไทย",
            "Klingon — tlhIngan",
            "Turkish — Türkçe",
            "Tatar — Татарча",
            "Ukrainian — Українська",
            "Urdu — اردو",
            "Uzbek — Узбекча",
            "Vietnamese — Tiếng Việt",
            "Chinese simplified — 简体中文",
            "Chinese traditional — 繁體中文"
          ],
          "default": "en"
        },
        "cucumberautocomplete.pages": {
          "description": "Object, which consists of 'page name' => 'page object file path' pairs",
          "type": "object",
          "required": false,
          "default": {}
        },
        "cucumberautocomplete.syncfeatures": {
          "description": "Will get steps using count from glob-style path or from '**/*.feature' if true",
          "type": [
            "boolean",
            "string"
          ],
          "required": false,
          "default": "test/features/*.feature"
        },
        "cucumberautocomplete.strictGherkinCompletion": {
          "description": "Strict comparing of declaration func and gherkin word (ex. show only steps, declared via 'When()' func for the 'When ' string",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.strictGherkinValidation": {
          "description": "Compare step body and gherkin word during steps validation",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.smartSnippets": {
          "description": "Change all the parts, that requires some user input (like .*, ([a-z]+), \\w{1,3}) to snippets",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.stepsInvariants": {
          "description": "Show all the 'or' steps parts as separate suggestions (ex. show `I use a` and `I use b` steps suggestions for the `I use (a|b)` step",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.customParameters": {
          "description": "Change step RegEx parts using 'parameter'/'value' pairs. Set 'isRegex': true to interpret 'parameter' as a regular expression string (optional 'flags').",
          "type": "array",
          "required": false,
          "default": []
        },
        "cucumberautocomplete.skipDocStringsFormat": {
          "description": "Skip format of strings, that placed between ''' or \"\"\" strings",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.skipStepValidationTags": {
          "description": "Skip missing-step diagnostics for steps under a Feature, Rule, Scenario, or Scenario Outline that carries any of these tags (e.g. [\"@ai\"]). Tags inherit downward.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false,
          "default": []
        },
        "cucumberautocomplete.formatConfOverride": {
          "description": "Override some formatting via format conf strings = {[key: String]: num | 'relative'}, where key - beggining of the string, num - numeric value of indents",
          "type": "object",
          "required": false,
          "default": {}
        },
        "cucumberautocomplete.onTypeFormat": {
          "description": "Enable ontype formattings (activating after pressing on space, @ and : keys)",
          "type": "boolean",
          "required": false,
          "default": false
        },
        "cucumberautocomplete.gherkinDefinitionPart": {
          "description": "Provide step definition name part of regex(ex. '@(given|when|then|step)\\(' in case of python-like steps. Please ensure, that they are placed in regex match '()' braces",
          "type": "string",
          "required": false
        },
        "cucumberautocomplete.stepRegExSymbol": {
          "description": "Provide step regex symbol. Ex. it would be \"'\" for When('I do something') definition",
          "type": "string",
          "required": false
        },
        "cucumberautocomplete.pureTextSteps": {
          "description": "Using steps definitions as a text strings with custom cucumber expressions support",
          "type": "boolean",
          "required": false,
          "default": false
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "vsce package",
    "bundle": "npm run bundle:client && npm run bundle:client-assets && npm run bundle:server",
    "bundle:client": "esbuild gclient/src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=gclient/out/extension.js",
    "bundle:client-assets": "node scripts/copy-languageclient-assets.js",
    "bundle:server": "esbuild gserver/src/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=gserver/out/server.js",
    "lint": "eslint ./gclient/src ./gclient/test/suite ./gserver/src",
    "lint:fix": "eslint ./gclient/src ./gclient/test/suite ./gserver/src --fix",
    "postinstall": "npm --prefix gclient ci && npm --prefix gserver ci",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "publish": "vsce publish",
    "login": "vsce login",
    "test:server": "jest",
    "test:coverage:jest": "jest --coverage",
    "compile:e2e": "npm run compile && tsc -p ./gclient/test/tsconfig.json",
    "test:e2e": "npm run compile:e2e && vscode-test",
    "test:e2e:coverage": "node -e \"require('node:fs').rmSync('coverage/e2e',{recursive:true,force:true})\" && npm run compile:e2e && vscode-test --coverage --coverage-output coverage/e2e",
    "coverage:check": "node ./scripts/check-combined-coverage.mjs",
    "test:coverage": "npm run test:coverage:jest && npm run test:e2e:coverage && npm run coverage:check",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@azure/identity": "4.13.1",
    "qs": "6.16.0",
    "tmp": "0.2.7"
  }
}
